# Web 登录（必填）
WEB_USER=admin
WEB_PASSWORD=change-me-please

# 时区
TZ=Asia/Shanghai

# 可选：将连接配置固定在环境变量中；设置后会覆盖 Web 设置页中的对应值
# EMBY_HOST=http://127.0.0.1:8096
# EMBY_KEY=
# TMDB_KEY=
# TG_BOT_TOKEN=
# TG_CHAT_ID=
# TG_ALLOWED_USERS=

# 双库路径只建议在 docker-compose.yml 的 environment 中配置
# L_ROOT=/media/local
# S_ROOT=/media/share
# CLOUD_L_ROOT=/media/cloud

# CloudDrive2 挂载看门狗：使用 CloudDrive2 联动删除时开启
# ENABLE_CD2_WATCHDOG=1
